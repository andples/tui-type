# Copy to .env (chmod 600). .env is git-ignored; never commit real values.

# Cloudflare Tunnel token for the cloudflared service (from the Cloudflare
# dashboard or the tunnel API). The tunnel's public hostname routes to
# http://ttyp-server:8080 on the compose network.
TUNNEL_TOKEN=<your tunnel token>

# Optional
#TTYP_PORT=8080
#RUST_LOG=info
#TTYP_BACKUP_KEEP=14
